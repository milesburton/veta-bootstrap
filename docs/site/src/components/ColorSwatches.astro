---
interface Swatch {
  name: string;
  cssVar: string;
  rgb: string;
  note?: string;
}
interface Props {
  swatches: Swatch[];
  columns?: number;
}
const { swatches, columns = 4 } = Astro.props;
---

<div class="app-swatch-grid not-content" style={`--app-swatch-columns: ${columns};`}>
  {
    swatches.map((s) => (
      <div class="app-swatch-card">
        <div class="app-swatch-color" style={`background: rgb(${s.rgb});`} />
        <div class="app-swatch-meta">
          <code class="app-swatch-var">{s.cssVar}</code>
          <span class="app-swatch-name">{s.name}</span>
          {s.note && <span class="app-swatch-note">{s.note}</span>}
        </div>
      </div>
    ))
  }
</div>

<style>
  .app-swatch-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 40rem) {
    .app-swatch-grid {
      grid-template-columns: repeat(var(--app-swatch-columns, 4), 1fr);
    }
  }
  .app-swatch-card {
    border: 1px solid rgb(var(--gray-700));
    border-radius: 0.5rem;
    overflow: hidden;
    background: rgb(var(--gray-900));
  }
  .app-swatch-color {
    height: 3rem;
  }
  .app-swatch-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.6rem;
  }
  .app-swatch-var {
    font-size: 0.7rem;
    color: rgb(var(--gray-300));
  }
  .app-swatch-name {
    font-size: 0.75rem;
    color: rgb(var(--gray-400));
  }
  .app-swatch-note {
    font-size: 0.68rem;
    color: rgb(var(--gray-500));
  }
</style>
